{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "taiki-photo-capture",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-13",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "taiki-photo-capture",
      "database_id": "01c062ae-2453-4f28-9ced-a855e51f9259",
      "migrations_dir": "./migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "taiki-private-media"
    }
  ],
  "vars": {
    "AUTH_MODE": "access",
    "TEAM_DOMAIN": "https://damp-violet-b08b.cloudflareaccess.com",
    "POLICY_AUD": "51c729559088984407b5100b6ae8f968e69668df51ed09a9ddee3740dcf7b866"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
